  "flows": {
    "lead": {
      "trigger": "lead_request",
      "store": "lead",
      "cancel_keywords": ["отмена", "стоп", "не надо", "передумал", "не хочу"],
      "steps": [
        {
          "key": "name",
          "prompt": "Отлично! Подскажите, как вас зовут?",
          "validate": "name",
          "error": "Пожалуйста, укажите имя (минимум 2 символа)."
        },
        {
          "key": "phone",
          "prompt": "Укажите, пожалуйста, номер телефона для связи.",
          "validate": "phone",
          "error": "Не похоже на номер телефона. Введите номер в формате +7 (999) 123-45-67."
        },
        {
          "key": "program",
          "prompt": "Какое направление или программу рассматриваете? Если не определились — так и напишите.",
          "validate": "nonempty",
          "error": "Напишите, пожалуйста, направление или «не определился»."
        }
      ],
      "completion": "Спасибо, {name}! Заявка принята: телефон {phone}, направление — {program}. Консультант приёмной комиссии свяжется с вами в ближайшее время."
    }
